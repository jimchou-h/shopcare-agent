# 本地启动配置示例：复制为 .env 后按需修改。
# .env 已被 .gitignore 忽略，不要提交真实 Key，也不要把 Key 写入仓库文件。

# preset：只使用预置 FAQ 检索，不调用模型（默认）
# deepseek：由服务端调用 DeepSeek，需要填写下面的 DEEPSEEK_API_KEY
CHAT_MODE=preset

# 仅 CHAT_MODE=deepseek 时必填；留空会启动失败并提示缺少变量名。
DEEPSEEK_API_KEY=

# 可选：服务端监听端口，默认 3000
# PORT=3000
# HOST=0.0.0.0

# 可选：Docker Compose 映射到宿主机的端口（pnpm start 不读取此项）
# APP_PORT=3200
